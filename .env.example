# Add provider credentials only on the local machine. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Comma-separated exact origins permitted to call this local gateway.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,https://siam-dev5.github.io,https://social-api.siamhrbp.com

# Social & Commerce foundation (local only)
# Generate once with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep this value private and back it up securely. Never commit a real key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_COMMERCE_DB=data/social_commerce.sqlite3

# Platform OAuth credentials are added after creating/approving each developer app.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/api/social-commerce/oauth/meta/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/social-commerce/oauth/google/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/social-commerce/oauth/tiktok/callback
